{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paydirt",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["PAYDIRT_ADMIN_TOKEN"]
  },
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "workflows": [
    {
      "name": "paydirt-discovery",
      "binding": "DISCOVERY_WORKFLOW",
      "class_name": "DiscoveryWorkflow",
      "schedules": ["0 14 * * 1"]
    },
    {
      "name": "paydirt-validation",
      "binding": "VALIDATION_WORKFLOW",
      "class_name": "ValidationWorkflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paydirt",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
